const CFG={ID:'1dptYdGUgo1nquL7ILfJR2MiAAUp65yV-o47aQ5iVG1I',P:'PERSONAL',C:'CALIFICACIONES',A:'ADMINISTRADORES',Y:Array.from({length:36},(_,i)=>String(2015+i))};
function doGet(e){const p=e.parameter||{},cb=String(p.callback||'');let out;try{out={ok:true,data:p.action==='health'?{service:'Sistema de registro de calificaciones API'}:dispatch_(p)}}catch(err){out={ok:false,error:err.message||'Error'}}const json=JSON.stringify(out);if(cb&&/^[A-Za-z_$][\w$]*$/.test(cb))return ContentService.createTextOutput(cb+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON)}
function dispatch_(p){switch(p.action){case'login':return login_(p.dni);case'myScores':{const u=session_(p.token,false),r=score_(u.dni);return{submitted:r.submitted,scores:r.scores}}case'submitScores':{const u=session_(p.token,false),l=LockService.getScriptLock();l.waitLock(10000);try{if(score_(u.dni).submitted)throw Error('Ya registraste tus calificaciones. Contactá a un administrador.');write_(u.dni,JSON.parse(p.scores||'{}'),false);return{message:'Guardado correctamente'}}finally{l.releaseLock()}}case'adminRows':return adminRows_(p.token,p.search||'');case'adminUsers':return adminUsers_(p.token,p.search||'');case'adminSetUserAccess':return adminSetUserAccess_(p.token,p.dni,p.access);case'adminSaveScores':{session_(p.token,true);if(!person_(p.dni))throw Error('El DNI no figura en la nómina.');const lock=LockService.getScriptLock();lock.waitLock(10000);try{write_(p.dni,JSON.parse(p.scores||'{}'),true);return{message:'Actualizado'}}finally{lock.releaseLock()}}case'adminDeleteScores':{session_(p.token,true);const lock=LockService.getScriptLock();lock.waitLock(10000);try{const r=score_(p.dni);if(!r.submitted)throw Error('No hay calificaciones registradas.');const info=ensureScoreHeaders_();info.sheet.getRange(r.row,2,1,info.headers.length-1).clearContent();return{message:'Calificaciones eliminadas'}}finally{lock.releaseLock()}}case'adminDeleteYear':{session_(p.token,true);const year=String(p.year||'');if(!CFG.Y.includes(year))throw Error('Año no válido.');const lock=LockService.getScriptLock();lock.waitLock(10000);try{const r=score_(p.dni);if(!r.submitted)throw Error('No hay calificaciones registradas.');const info=ensureScoreHeaders_(),col=info.headers.indexOf(year)+1;if(col<2)throw Error('No se encontró la columna del año.');info.sheet.getRange(r.row,col).clearContent();return{message:'Calificación del año eliminada'}}finally{lock.releaseLock()}}default:throw Error('Acción no reconocida.')}}
function ss_(){return SpreadsheetApp.openById(CFG.ID)}function sh_(n){const s=ss_().getSheetByName(n);if(!s)throw Error('Falta la pestaña '+n);return s}function clean_(v){return String(v||'').replace(/\D/g,'')}function rows_(n,w){const s=sh_(n);return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,w||s.getLastColumn()).getDisplayValues().map((v,i)=>({v,row:i+2}))}
function ensureScoreHeaders_(){const s=sh_(CFG.C);if(s.getLastColumn()===0||s.getLastRow()===0)s.getRange(1,1).setValue('DNI');let last=Math.max(s.getLastColumn(),1),headers=s.getRange(1,1,1,last).getDisplayValues()[0].map(v=>String(v).trim().toUpperCase());if(!headers[0]){s.getRange(1,1).setValue('DNI');headers[0]='DNI'}if(headers[0]!=='DNI')throw Error('La primera columna de CALIFICACIONES debe ser DNI.');CFG.Y.forEach(y=>{if(!headers.includes(y)){last++;s.getRange(1,last).setValue(y);headers.push(y)}});return{sheet:s,headers:headers}}
function person_(dni){const r=rows_(CFG.P,3).find(x=>clean_(x.v[0])===clean_(dni));return r?{dni:clean_(r.v[0]),hierarchy:r.v[1]||'',name:r.v[2]||''}:null}function isAdminValue_(v){return ['ADMIN','ADMINISTRADOR','SI','SÍ','TRUE','1'].includes(String(v||'').trim().toUpperCase())}function admin_(dni){const r=rows_(CFG.A,2).find(x=>clean_(x.v[0])===clean_(dni));return !!r&&isAdminValue_(r.v[1])}
function score_(dni){const info=ensureScoreHeaders_(),all=info.sheet.getLastRow()<2?[]:info.sheet.getRange(2,1,info.sheet.getLastRow()-1,info.headers.length).getDisplayValues();for(let i=0;i<all.length;i++){if(clean_(all[i][0])===clean_(dni)){const scores={};CFG.Y.forEach(y=>{const idx=info.headers.indexOf(y);scores[y]=idx>=0?(all[i][idx]||''):''});return{submitted:true,row:i+2,scores}}}const empty={};CFG.Y.forEach(y=>empty[y]='');return{submitted:false,row:null,scores:empty}}
function session_(token,needAdmin){const raw=token?CacheService.getScriptCache().get('sess_'+token):null;if(!raw)throw Error('Sesión vencida. Volvé a ingresar.');const u=person_(raw);if(!u)throw Error('El usuario ya no figura en la nómina.');u.admin=admin_(u.dni);if(needAdmin&&!u.admin)throw Error('No tenés permisos de administrador.');return u}function login_(dni){const d=clean_(dni);if(d.length<6||d.length>10)throw Error('Ingresá un DNI válido.');const u=person_(d);if(!u)throw Error('El DNI no figura en la nómina autorizada.');u.admin=admin_(d);const token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('sess_'+token,d,21600);return{token,user:u}}
function write_(dni,s,merge){const info=ensureScoreHeaders_(),old=score_(dni),scores={};CFG.Y.forEach(y=>scores[y]=merge?(old.scores[y]||''):'');let changed=0;CFG.Y.forEach(y=>{if(!Object.prototype.hasOwnProperty.call(s,y)||String(s[y]??'').trim()==='')return;let v=String(s[y]).trim();if(v.toUpperCase()==='NO FUE CALIFICADO'){scores[y]='NO FUE CALIFICADO';changed++;return}const normalized=v.replace(',','.');const n=Number(normalized);if(!Number.isFinite(n)||n<0||n>10||!/^(?:\d+)(?:\.\d{1,2})?$/.test(normalized))throw Error('La nota de '+y+' debe estar entre 0 y 10, con hasta dos decimales.');scores[y]=n;changed++});if(!changed)throw Error('Agregá al menos un año con nota o marcá No fue calificado.');const vals=Array(info.headers.length).fill('');vals[0]=clean_(dni);CFG.Y.forEach(y=>{const idx=info.headers.indexOf(y);if(idx>=0)vals[idx]=scores[y]});if(old.submitted)info.sheet.getRange(old.row,1,1,info.headers.length).setValues([vals]);else info.sheet.appendRow(vals)}
function adminRows_(token,q){session_(token,true);const info=ensureScoreHeaders_(),data=info.sheet.getLastRow()<2?[]:info.sheet.getRange(2,1,info.sheet.getLastRow()-1,info.headers.length).getDisplayValues(),map={};data.forEach(row=>{const sc={};CFG.Y.forEach(y=>{const idx=info.headers.indexOf(y);sc[y]=idx>=0?(row[idx]||''):''});map[clean_(row[0])]=sc});q=String(q).toLowerCase();const list=rows_(CFG.P,3).map(r=>{const dni=clean_(r.v[0]);return{dni,hierarchy:r.v[1]||'',name:r.v[2]||'',scores:map[dni]||null,submitted:!!map[dni]}}).filter(p=>p.dni&&(p.dni+' '+p.hierarchy+' '+p.name).toLowerCase().includes(q));return{rows:list,years:CFG.Y,stats:{total:list.length,submitted:list.filter(p=>p.submitted).length,pending:list.filter(p=>!p.submitted).length,fullyGraded:list.filter(p=>p.submitted&&CFG.Y.every(y=>String(p.scores[y]).trim()!==''&&String(p.scores[y]).toUpperCase()!=='NO FUE CALIFICADO')).length}}}
function adminUsers_(token,q){session_(token,true);const accessSheet=sh_(CFG.A);if(accessSheet.getLastRow()===0)accessSheet.getRange(1,1,1,2).setValues([['DNI','ACCESO']]);q=String(q||'').trim().toLowerCase();const access={};rows_(CFG.A,2).forEach(r=>{const d=clean_(r.v[0]);if(d)access[d]=isAdminValue_(r.v[1])});return{rows:rows_(CFG.P,3).map(r=>{const dni=clean_(r.v[0]);return{dni,hierarchy:r.v[1]||'',name:r.v[2]||'',admin:access[dni]===true}}).filter(p=>p.dni&&(p.dni+' '+p.hierarchy+' '+p.name).toLowerCase().includes(q))}}
function adminSetUserAccess_(token,dni,accessValue){const actor=session_(token,true),d=clean_(dni),person=person_(d);if(!person)throw Error('El DNI no figura en la nómina.');const desired=String(accessValue||'').trim().toUpperCase();if(!['ADMIN','NO'].includes(desired))throw Error('Permiso no válido.');if(actor.dni===d&&desired!=='ADMIN')throw Error('No podés quitarte tu propio acceso de administrador.');const lock=LockService.getScriptLock();lock.waitLock(10000);try{const found=rows_(CFG.A,2).find(r=>clean_(r.v[0])===d),sht=sh_(CFG.A);if(found)sht.getRange(found.row,1,1,2).setValues([[d,desired]]);else sht.appendRow([d,desired]);return{message:'Permisos actualizados',dni:d,access:desired}}finally{lock.releaseLock()}}
